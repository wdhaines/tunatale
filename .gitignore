# Prototype directories — each has its own git repo
micro-demo-0.0/
micro-demo-0.1/

# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
.eggs/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
!.env.example
# Placeholders only, same as .env.example. `.env.*` swallowed it silently, and
# a template nobody can clone is worse than none — ./test.sh validates this one
# via scripts/check_prod_env.py, so a missing file fails the gate.
!.env.prod.example

# SSL certs (local dev only)
certs/
*.pem

# Test & coverage artifacts
.coverage
coverage.xml
coverage.json
htmlcov/
.pytest_cache/
.mypy_cache/
*.py,cover

# Node / frontend
node_modules/
frontend/.svelte-kit/
frontend/build/

# Claude Code: team-shared rules + settings.json are tracked.
# Only per-user / scratch files stay local.
.claude/settings.local.json
.claude/plans/
.claude/scheduled_tasks.lock

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log

# Runtime data / DB
*.db
*.db-journal
*.db-shm
*.db-wal
*.db.bak*
*.db.pre_*

# TTS / audio cache
backend/cache/

# Imported Anki media (per-user, large)
backend/media/

# Generated outputs. (Ad-hoc script ignores moved to backend/scripts/.gitignore
# — a root-level "backend/scripts/*" glob broke ruff's local file discovery.)
backend/output/
frontend/test-results/
# Playwright's signed-in cookie, produced per run by tests/global-setup.ts.
# A session token — never committed.
frontend/tests/.auth/

# docs/briefs/ — retired from the workflow 2026-08-10; dispatch docs now live in
# the .beads-tasks submodule (version-controlled, off-machine). What remains is a
# gitignored local safety copy, rebuilt from bd + the submodule, kept until the
# new setup proves out. See docs/briefs/README.md. Do not author new content
# there: gitignored means no history, one copy, no recovery path.
docs/briefs/
.ci-apt-cache
