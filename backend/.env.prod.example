# Production profile template. Copy to the box as backend/.env and fill in the
# real values. Validated by `uv run python scripts/check_prod_env.py`, which
# ./test.sh runs against THIS file — so it must stay a profile that boots.
#
# With TT_ENV=prod the app REFUSES to start if any of the settings below is
# wrong (app/main.py::_assert_prod_profile). That is deliberate: every failure
# it catches produces a server that looks perfectly healthy.

# Arms the startup guard. Unset (or "dev") = the local/Tailscale setup.
TT_ENV=prod

# --- LLM ---
# Without this the app serves recorded cassette replies and reports 200s.
LLM_MODE=live
GROQ_API_KEY=set-me

# --- Auth (Phase 1 gives these teeth; the guard already requires them) ---
AUTH_ENABLED=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=set-me

# --- CORS ---
# JSON list, NOT comma-separated. A wildcard is rejected by the guard.
# Served same-origin behind Caddy, so this is normally just the site itself.
CORS_ORIGINS=["https://tunatale.example.com"]
# Optional scoped pattern for origins that can't be enumerated (per-tailnet
# MagicDNS names). A catch-all (".*") is rejected.
# CORS_ALLOW_ORIGIN_REGEX=^https://[a-z0-9-]+\.[a-z0-9-]+\.ts\.net:5173$

# --- Data ---
# Container-safe paths land in Deploy P0.1; HOME=/data relocates the rest.
DATABASE_URLS={"sl": "sqlite:////data/tunatale_sl.db", "no": "sqlite:////data/tunatale_no.db"}
TARGET_LANGUAGE=sl

# --- Lemmatization ---
# The classla/stanza engines pull PyTorch. Not viable on a 2 OCPU / 12 GB ARM
# box; the prod image builds without those groups.
LEMMATIZER_TYPE=lowercase

# --- Anki (optional; each user connects their own AnkiWeb account) ---
SYNC_ENABLED=false
