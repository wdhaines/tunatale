{
 "id": "verb-chart",
 "title": "The verb chart",
 "intro": "To find a verb form, ask three questions. What is the sentence about, the phrase marked *ang*: the doer, the thing done to, a place or person, or the thing used? That picks the band. Is it one act, something going on, or many? That picks the row. Has it happened yet, and did someone mean to do it? That picks the column. Each cell gives the affix, what it means in English, and an example; most use *palít* 'buy'. A verb of state, like 'sleep' or 'be red', has no doer and gets its own band at the bottom.",
 "modes": [
  {
   "id": "volitional",
   "label": "Volitional",
   "hint": "done on purpose",
   "footnote": 3,
   "columns": [
    {
     "id": "realis",
     "label": "Realis",
     "hint": "begun: happened, or happening now",
     "footnote": null
    },
    {
     "id": "irrealis",
     "label": "Irrealis",
     "hint": "not begun: future, habit, wish",
     "footnote": null
    },
    {
     "id": "dependent",
     "label": "Dependent",
     "hint": "after *walâ* or a time word",
     "footnote": 1
    },
    {
     "id": "imperative",
     "label": "Imperative",
     "hint": "a command; none in the potential",
     "footnote": 2
    }
   ]
  },
  {
   "id": "potential",
   "label": "Potential",
   "hint": "can, managed to, by chance; on a verb of state, the state itself",
