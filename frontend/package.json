{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"preview:robust": "bun scripts/preview.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "SVELTEKIT_OUT_DIR=.svelte-kit-test svelte-kit sync && SVELTEKIT_OUT_DIR=.svelte-kit-test svelte-check --tsconfig ./tsconfig.test.json",
		"check:watch": "SVELTEKIT_OUT_DIR=.svelte-kit-test svelte-kit sync && SVELTEKIT_OUT_DIR=.svelte-kit-test svelte-check --tsconfig ./tsconfig.test.json --watch",
		"gen:api": "openapi-typescript src/lib/api-schema.json -o src/lib/api-types.d.ts && oxfmt src/lib/api-types.d.ts",
		"check:api": "mkdir -p node_modules/.tmp && openapi-typescript src/lib/api-schema.json -o node_modules/.tmp/api-types-check.d.ts && oxfmt node_modules/.tmp/api-types-check.d.ts && diff -q src/lib/api-types.d.ts node_modules/.tmp/api-types-check.d.ts || (echo 'FAIL: src/lib/api-types.d.ts is stale. Fix: bun run gen:api' && exit 1)",
		"test": "SVELTEKIT_OUT_DIR=.svelte-kit-test vitest run",
		"test:coverage": "SVELTEKIT_OUT_DIR=.svelte-kit-test vitest run --coverage && bun scripts/coverage-gate.ts",
		"test:watch": "SVELTEKIT_OUT_DIR=.svelte-kit-test vitest",
		"test:e2e": "playwright test",
		"fmt": "oxfmt 'src/**/*.ts' 'src/**/*.js'",
		"fmt:check": "oxfmt --check 'src/**/*.ts' 'src/**/*.js'",
		"lint:fast": "oxlint src/ --ignore-pattern=*.svelte",
		"lint:svelte": "eslint src",
		"lint": "bun run lint:fast && bun run lint:svelte"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.1.1",
		"@vitest/coverage-v8": "^4.1.10",
		"@vitest/ui": "^4.1.10",
		"eslint": "^10.8.0",
		"eslint-plugin-oxlint": "^1.75.0",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.7.0",
		"jsdom": "^29.1.1",
		"openapi-typescript": "^7.13.0",
		"oxfmt": "^0.60.0",
		"oxlint": "^1.75.0",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.3",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	}
}
